<!DOCTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Super Mario Web Prototype</title>
    <style>
        body {
            margin: 0;
            padding: 0;
            background-color: #222;
            font-family: Arial, sans-serif;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
            overflow: hidden;
            touch-action: none;
        }

        #game-container {
            position: relative;
            width: 100%;
            max-width: 800px;
            aspect-ratio: 16 / 9;
            background-color: #5C94FC; /* Cor do céu clássica */
            border: 4px solid #000;
            box-shadow: 0 10px 20px rgba(0,0,0,0.5);
        }

        canvas {
            width: 100%;
            height: 100%;
            image-rendering: pixelated; /* Mantém o aspecto retrô */
        }

        /* Controles Mobile */
        .controls {
            position: absolute;
            bottom: 10px;
            width: 100%;
            display: flex;
            justify-content: space-between;
            padding: 0 20px;
            box-sizing: border-box;
            pointer-events: none;
        }

        .d-pad, .action-buttons {
            display: flex;
            gap: 15px;
            pointer-events: auto;
        }

        .btn {
            width: 60px;
            height: 60px;
            background: rgba(255, 255, 255, 0.3);
            border: 3px solid #fff;
            border-radius: 50%;
            display: flex;
            justify-content: center;
            align-items: center;
            font-weight: bold;
            color: white;
            user-select: none;
            cursor: pointer;
        }

        .btn:active {
            background: rgba(255, 255, 255, 0.6);
        }
    </style>
</head>
<body>

<div id="game-container">
    <canvas id="marioCanvas"></canvas>
    
    <div class="controls">
        <div class="d-pad">
            <div class="btn" id="leftBtn">◀</div>
            <div class="btn" id="rightBtn">▶</div>
        </div>
        <div class="action-buttons">
            <div class="btn" id="jumpBtn" style="background: rgba(255, 0, 0, 0.4);">A</div>
        </div>
    </div>
</div>

<script>
    const canvas = document.getElementById('marioCanvas');
    const ctx = canvas.getContext('2d');

    // Resolução interna fixa para manter proporção
    canvas.width = 800;
    canvas.height = 450;

    // Configurações do Jogo
    const gravity = 0.8;
    const friction = 0.8;

    const player = {
        x: 100,
        y: 300,
        width: 40,
        height: 40,
        speed: 5,
        velX: 0,
        velY: 0,
        jumping: false,
        color: "#E74C3C" // Vermelho Mario
    };

    // Plataformas simples
    const platforms = [
        { x: 0, y: 400, width: 800, height: 50 }, // Chão
        { x: 200, y: 300, width: 150, height: 20 },
        { x: 450, y: 220, width: 150, height: 20 },
        { x: 100, y: 150, width: 100, height: 20 }
    ];

    const keys = {};
    let touchLeft = false;
    let touchRight = false;

    // Listeners de Teclado (PC)
    window.addEventListener("keydown", e => keys[e.code] = true);
    window.addEventListener("keyup", e => keys[e.code] = false);

    // Listeners de Toque (Mobile)
    setupTouchBtn('leftBtn', val => touchLeft = val);
    setupTouchBtn('rightBtn', val => touchRight = val);
    
    document.getElementById('jumpBtn').addEventListener('touchstart', (e) => {
        e.preventDefault();
        if (!player.jumping) {
            player.velY = -15;
            player.jumping = true;
        }
    });

    function setupTouchBtn(id, callback) {
        const btn = document.getElementById(id);
        btn.addEventListener('touchstart', (e) => { e.preventDefault(); callback(true); });
        btn.addEventListener('touchend', (e) => { e.preventDefault(); callback(false); });
    }

    function update() {
        // Movimento
        if (keys["ArrowRight"] || touchRight) {
            if (player.velX < player.speed) player.velX++;
        }
        if (keys["ArrowLeft"] || touchLeft) {
            if (player.velX > -player.speed) player.velX--;
        }

        // Pulo Teclado
        if ((keys["Space"] || keys["ArrowUp"]) && !player.jumping) {
            player.velY = -15;
            player.jumping = true;
        }

        player.velX *= friction;
        player.velY += gravity;

        player.x += player.velX;
        player.y += player.velY;

        // Colisões com Plataformas
        player.jumping = true;
        for (let plat of platforms) {
            if (player.x < plat.x + plat.width &&
                player.x + player.width > plat.x &&
                player.y < plat.y + plat.height &&
                player.y + player.height > plat.y) {
                
                // Colisão por cima
                if (player.velY > 0) {
                    player.jumping = false;
                    player.y = plat.y - player.height;
                    player.velY = 0;
                }
            }
        }

        // Limites da tela
        if (player.x < 0) player.x = 0;
        if (player.x + player.width > canvas.width) player.x = canvas.width - player.width;
    }

    function draw() {
        // Limpar tela
        ctx.clearRect(0, 0, canvas.width, canvas.height);

        // Desenhar Chão/Plataformas
        ctx.fillStyle = "#8B4513"; // Marrom terra
        for (let plat of platforms) {
            ctx.fillRect(plat.x, plat.y, plat.width, plat.height);
            // Grama no topo
            ctx.fillStyle = "#2ECC71";
            ctx.fillRect(plat.x, plat.y, plat.width, 5);
            ctx.fillStyle = "#8B4513";
        }

        // Desenhar Jogador
        ctx.fillStyle = player.color;
        ctx.fillRect(player.x, player.y, player.width, player.height);
        
        // Detalhe do "boné"
        ctx.fillStyle = "white";
        ctx.fillRect(player.x + 10, player.y + 5, 20, 5);

        requestAnimationFrame(() => {
            update();
            draw();
        });
    }

    draw();
</script>

</body>
</html>
